<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_report_designer" model="ir.module.category">
        <field name="name">Report Designer</field>
        <field name="sequence">200</field>
    </record>

    <record id="group_report_designer_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_report_designer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_report_designer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_report_designer"/>
        <field name="implied_ids" eval="[(4, ref('group_report_designer_user'))]"/>
    </record>

</odoo>
