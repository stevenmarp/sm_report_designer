<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sm_report_template_wizard_view_form" model="ir.ui.view">
        <field name="name">sm.report.template.wizard.form</field>
        <field name="model">sm.report.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Report Template">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids_json" invisible="1"/>
                    <field name="available_template_ids" invisible="1"/>
                    <field name="template_id"/>
                </group>
                <footer>
                    <button name="action_print"
                            string="Print"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
